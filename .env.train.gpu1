TRAIN_MODE=single # single or multi

# Path to train config
# TRAIN_CONFIG_PATH=olmocr/train/configs/v0.5.0/qwen3_vl_olmocrv5_1epoch_mix_1025_filtered.yaml
TRAIN_CONFIG_PATH=olmocr/train/configs/v0.5.0/qwen35_9b_1epoch.yaml
# Python binary (set to your venv python if needed)
TRAIN_PYTHON_BIN=python

# Memory allocator config
TRAIN_ALLOC_CONF=expandable_segments:True

# GPU selection
TRAIN_CUDA_VISIBLE_DEVICES_SINGLE=1
TRAIN_CUDA_VISIBLE_DEVICES_MULTI=0,1

# Optional: override process count in multi mode.
# Leave empty to auto-count from TRAIN_CUDA_VISIBLE_DEVICES_MULTI.
TRAIN_NPROC_PER_NODE=

# Optional: fixed port for torch distributed
TRAIN_MASTER_PORT=29501



# Qwen3.5-9b

# Model
MODEL_NAME=Qwen/Qwen3.5-9B
TORCH_DTYPE=bfloat16
USE_FLASH_ATTENTION=true
ATTN_IMPLEMENTATION=flash_attention_2
TRUST_REMOTE_CODE=true

# LoRA
USE_LORA=true
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Training
LEARNING_RATE=5e-6
WEIGHT_DECAY=0.1
WARMUP_RATIO=0.15
GRADIENT_ACCUMULATION_STEPS=16
GRADIENT_CHECKPOINTING=true

# Data
TARGET_LONGEST_IMAGE_DIM=1288